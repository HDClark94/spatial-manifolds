   "source": [
    "\"\"\"\n",
    "Trial-level pupil dilation (proxy for arousal/attention) vs. population\n",
    "anchoring state. Mean dilation per trial from the same position-binned,\n",
    "blink- and zero-fill-corrected eye_dil_trials computed above -- no\n",
    "recomputation needed.\n",
    "\"\"\"\n",
    "dil_mean_per_trial = np.nanmean(eye_dil_trials, axis=1)\n",
    "\n",
    "valid_dil = ~np.isnan(dil_mean_per_trial) & ~np.isnan(frac_anchored)\n",
    "r_dil, p_dil = spearmanr(frac_anchored[valid_dil], dil_mean_per_trial[valid_dil])\n",
    "print(f'Spearman corr(frac_anchored, trial mean pupil dilation) = {r_dil:.2f} (p={p_dil:.3f}), n={valid_dil.sum()} trials')\n",
    "\n",
    "anchored_trials_dil = valid_dil & (frac_anchored > 0.5)\n",
    "nonanchored_trials_dil = valid_dil & (frac_anchored <= 0.5)\n",
    "u_dil, p_mw_dil = mannwhitneyu(dil_mean_per_trial[anchored_trials_dil], dil_mean_per_trial[nonanchored_trials_dil],\n",
    "                                alternative='two-sided')\n",
    "print(f'population-anchored trials (n={anchored_trials_dil.sum()}): '\n",
    "      f'mean pupil dilation={np.nanmean(dil_mean_per_trial[anchored_trials_dil]):.2f}')\n",
    "print(f'population-non-anchored trials (n={nonanchored_trials_dil.sum()}): '\n",
    "      f'mean pupil dilation={np.nanmean(dil_mean_per_trial[nonanchored_trials_dil]):.2f}')\n",
    "print(f'Mann-Whitney U={u_dil:.0f}, p={p_mw_dil:.3f}')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(8, 3.2))\n",
    "ax = axes[0]\n",
    "ax.scatter(frac_anchored[valid_dil], dil_mean_per_trial[valid_dil], s=10, color=ANCH_COLOR, alpha=0.6)\n",
    "ax.set_xlabel('fraction of population anchored (trial)')\n",
    "ax.set_ylabel('mean pupil dilation\\n(trial)')\n",
    "ax.set_title(f'r={r_dil:.2f}, p={p_dil:.3f}', fontsize=9)\n",
    "\n",
    "ax = axes[1]\n",
    "bp = ax.boxplot([dil_mean_per_trial[nonanchored_trials_dil], dil_mean_per_trial[anchored_trials_dil]],\n",
    "                 tick_labels=['non-anchored\\n(<=50% cells)', 'anchored\\n(>50% cells)'],\n",
    "                 patch_artist=True, widths=0.5)\n",
    "for patch, color in zip(bp['boxes'], [NONANCH_COLOR, ANCH_COLOR]):\n",
    "    patch.set_facecolor(color)\n",
    "ax.set_ylabel('mean pupil dilation (trial)')\n",
    "ax.set_title(f'Mann-Whitney p={p_mw_dil:.3f}', fontsize=9)\n",
    "\n",
    "fig.suptitle(f'M{MOUSE}D{DAY}: pupil dilation vs. population task-anchoring', fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join(FIGPATH, f'eye_dilation_vs_anchoring_M{MOUSE}D{DAY}.pdf'), dpi=200, bbox_inches='tight')\n",
    "plt.show()"
   ]
