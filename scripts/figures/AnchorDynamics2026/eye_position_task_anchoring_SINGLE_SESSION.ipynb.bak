   "source": [
    "# Eye (pupil) centroid position across task-anchored vs. non-anchored epochs\n",
    "\n",
    "Curiosity check: during epochs where the population of MEC cells is\n",
    "task-anchored (spatially tuned, locked to landmarks/track structure) versus\n",
    "non-anchored, does the animal's gaze (pupil centroid, `eye_x`/`eye_y` from\n",
    "DeepLabCut tracking) show any systematic deviation -- e.g. looking away from\n",
    "wherever it \"should\" be looking if reliably attending to the same visual\n",
    "cues each trial?\n",
    "\n",
    "Uses mouse 25, day 24 (M25D24) -- the same VR session already analyzed in\n",
    "`trial_cluster_anchoring.ipynb` -- reusing its cached per-cell\n",
    "anchored/non-anchored trial labels (`all_sessions_rasters/M25D24_cache.npz`)\n",
    "so nothing needs to be recomputed there. Eye position is available in the\n",
    "session's `beh.nwb` file as DeepLabCut-tracked pupil centroid coordinates\n",
    "(`eye_x`, `eye_y`, pixels, ~30Hz camera), synced to the same ephys clock as\n",
    "the neural/behavioural data. Population \"anchored state\" per trial is\n",
    "defined as the fraction of recorded cells labelled anchored on that trial\n",
    "(mean over the cached 0/1 label matrix), since eye position is a single\n",
    "session-wide signal, not a per-cell one."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "d3740762",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-31T08:44:27.658878Z",
     "iopub.status.busy": "2026-08-31T08:44:27.658087Z",
     "iopub.status.idle": "2026-08-31T08:44:42.952538Z",
     "shell.execute_reply": "2026-08-31T08:44:42.952108Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "bs=2cm, vr_tl=200cm, bins/trial=100\n"
     ]
    }
   ],
   "source": [
    "import sys, os\n",
    "sys.path.insert(0, '/Users/harryclark/Documents/spatial-manifolds/src')\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import pynapple as nap\n",
    "from scipy.stats import spearmanr, mannwhitneyu\n",
    "from spatial_manifolds.detect_grids import compute_vr_tcs\n",
    "from spatial_manifolds.anaylsis_parameters import bs, vr_tl\n",
    "\n",
    "FIGPATH = '/Users/harryclark/Documents/spatial-manifolds/scripts/figures/AnchorDynamics2026/'\n",
    "SOURCE_PATH = '/Users/harryclark/Downloads/COHORT12/'\n",
    "ALL_SESSIONS_DIR = '/Users/harryclark/Documents/spatial-manifolds/scripts/figures/AnchorDynamics2026/all_sessions_rasters/'\n",
    "\n",
    "ANCH_COLOR, NONANCH_COLOR = '#9d5391', '#5f9ea0'   # matches trial_cluster_anchoring.ipynb\n",
    "\n",
    "MOUSE, DAY = 25, 24\n",
    "bpt = int(vr_tl / bs)\n",
    "\n",
    "print(f'bs={bs}cm, vr_tl={vr_tl}cm, bins/trial={bpt}')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1c860778",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-31T08:44:42.956822Z",
     "iopub.status.busy": "2026-08-31T08:44:42.956044Z",
     "iopub.status.idle": "2026-08-31T08:44:49.800547Z",
     "shell.execute_reply": "2026-08-31T08:44:49.800009Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "M25D24: last_ephys_bin=22500, n_trials=225\n",
      "69 cells contribute to the population anchoring signal\n",
      "frac_anchored range=[0.12, 0.83], mean=0.50\n",
      "eye-tracking channels available: ['eye_dilation', 'eye_e_likelihood', 'eye_e_x', 'eye_e_y', 'eye_n_likelihood', 'eye_n_x', 'eye_n_y', 'eye_ne_likelihood', 'eye_ne_x', 'eye_ne_y', 'eye_nw_likelihood', 'eye_nw_x', 'eye_nw_y', 'eye_s_likelihood', 'eye_s_x', 'eye_s_y', 'eye_se_likelihood', 'eye_se_x', 'eye_se_y', 'eye_sw_likelihood', 'eye_sw_x', 'eye_sw_y', 'eye_w_likelihood', 'eye_w_x', 'eye_w_y', 'eye_x', 'eye_y']\n"
     ]
    }
   ],
   "source": [
    "\"\"\"\n",
    "Load M25D24's VR behaviour (including eye-tracking channels, already\n",
    "NWB-merged and ephys-clock-synced) via the same compute_vr_tcs() call used\n",
    "throughout trial_cluster_anchoring.ipynb, and the ALREADY-COMPUTED per-cell\n",
    "anchored/non-anchored trial labels for this session from the Part D batch\n",
    "cache (all_sessions_rasters/M25D24_cache.npz) -- no need to rerun the\n",
    "trial-clustering classifier here.\n",
    "\"\"\"\n",
    "tcs, tcs_time, _, last_ephys_bin, beh, clusters = compute_vr_tcs(\n",
    "    MOUSE, DAY, apply_zscore=False, apply_guassian_filter=False, source_path=SOURCE_PATH)\n",
    "n_trials = int(last_ephys_bin / bpt)\n",
    "print(f'M{MOUSE}D{DAY}: last_ephys_bin={last_ephys_bin}, n_trials={n_trials}')\n",
    "\n",
    "cache = np.load(os.path.join(ALL_SESSIONS_DIR, f'M{MOUSE}D{DAY}_cache.npz'), allow_pickle=True)\n",
    "label_matrix = cache['label_matrix']          # [n_cells, n_trials], 0/1 anchored labels\n",
    "cached_n_trials = int(cache['n_trials'])\n",
    "assert cached_n_trials == n_trials, f'trial count mismatch: cache={cached_n_trials}, here={n_trials}'\n",
    "frac_anchored = np.nanmean(label_matrix, axis=0)   # per-trial fraction of cells anchored (population state)\n",
    "print(f'{label_matrix.shape[0]} cells contribute to the population anchoring signal')\n",
    "print(f'frac_anchored range=[{frac_anchored.min():.2f}, {frac_anchored.max():.2f}], mean={frac_anchored.mean():.2f}')\n",
    "\n",
    "print('eye-tracking channels available:', sorted(k for k in beh.keys() if k.startswith('eye')))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "47f8b254",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-31T08:44:49.802546Z",
     "iopub.status.busy": "2026-08-31T08:44:49.802351Z",
     "iopub.status.idle": "2026-08-31T08:45:01.197253Z",
     "shell.execute_reply": "2026-08-31T08:45:01.196805Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0.33% of eye-camera frames flagged as blinks/tracking-loss (mean landmark likelihood < 0.5)\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "eye_x_trials shape=(225, 100), 4.11% NaN bins overall (blinks + no-camera-sample bins both correctly excluded now)\n",
      "trial 0 nan frac: 0.66 (partial first trial, expected)\n"
     ]
    }
   ],
   "source": [
    "\"\"\"\n",
    "Bin the continuous eye-tracking channels (eye_x, eye_y, eye_dilation; DLC\n",
    "pupil centroid + diameter, ~30Hz) onto the EXACT same trial x position-bin\n",
    "grid (bpt=100 bins/trial, bs=2cm) used for the neural tuning curves inside\n",
    "compute_vr_tcs -- same `dt` (cumulative track distance) feature, same\n",
    "`ep=beh['moving']` epoch, same n_bins/min_bound/max_bound formula, so every\n",
    "column here lines up 1:1 with a spatial bin in the neural rate maps and the\n",
    "cached anchoring labels. (Tsd objects loaded from the NWB are lazily backed\n",
    "by h5py and must be materialized into plain numpy-backed Tsds before\n",
    "pynapple's tuning-curve routines will accept them.)\n",
    "\n",
    "BLINK FILTERING: individual eye-camera frames occasionally fail tracking\n",
    "(blinks) and report near-zero/garbage pupil coordinates -- rare overall\n",
    "(~0.3% of frames here). Filtered out via the mean likelihood across the 8\n",
    "DeepLabCut pupil-perimeter landmarks (eye_n/ne/e/se/s/sw/w/nw_likelihood) --\n",
    "eye_x/eye_y themselves have no likelihood column since they're a derived\n",
    "centroid, but the landmarks they're derived from do.\n",
    "\n",
    "ZERO-FILL BUG (pynapple): `compute_1d_tuning_curves_continuous` computes bin\n",
    "occupancy from the DENSE ~60Hz position trace (`dt`) but averages the SPARSE\n",
    "~30Hz eye-camera samples that fall in each bin; reading its source\n",
    "(`pynapple/process/tuning_curves.py`) shows it sets every bin to `tc=0.0`\n",
    "first, THEN only overwrites with NaN the bins with zero occupancy IN THE\n",
    "DENSE POSITION TRACE. So any 2cm bin the animal visited (nonzero position\n",
    "occupancy) but that happened to contain zero eye-camera frames (entirely\n",
    "possible at this samplerate mismatch) silently keeps the placeholder `0.0`\n",
    "instead of becoming NaN -- confirmed directly: ~3.8% of bins end up exactly\n",
    "`0.0`, and a real gaze pixel value of exactly 0 is physically impossible\n",
    "here (raw eye_x/eye_y never go below ~90 even during blinks). Fixed by\n",
    "replacing exact-zero bins with NaN after the pynapple call.\n",
    "\"\"\"\n",
    "tl = vr_tl\n",
    "tns = beh['trial_number']\n",
    "dt = beh['travel'] - ((tns[0] - 1) * tl)\n",
    "n_bins = int(int(((np.ceil(np.nanmax(dt)) // tl) + 1) * tl) / bs)\n",
    "max_bound = int(((np.ceil(np.nanmax(dt)) // tl) + 1) * tl)\n",
    "min_bound = 0\n",
    "\n",
    "likelihood_keys = [k for k in beh.keys() if k.startswith('eye_') and k.endswith('likelihood')]\n",
    "mean_lik = np.nanmean(np.array([np.array(beh[k].values) for k in likelihood_keys]), axis=0)\n",
    "blink_mask = mean_lik < 0.5\n",
    "print(f'{100*blink_mask.mean():.2f}% of eye-camera frames flagged as blinks/tracking-loss (mean landmark likelihood < 0.5)')\n",
    "\n",
    "def materialize(tsd, mask_bad=None):\n",
    "    vals = np.array(tsd.values, dtype=float)\n",
    "    if mask_bad is not None:\n",
    "        vals = vals.copy()\n",
    "        vals[mask_bad] = np.nan\n",
    "    return nap.Tsd(t=np.array(tsd.index), d=vals)\n",
    "\n",
    "def bin_continuous(tsd, mask_bad=None):\n",
    "    tc = np.array(nap.compute_1d_tuning_curves_continuous(\n",
    "        materialize(tsd, mask_bad), dt, nb_bins=n_bins, minmax=[min_bound, max_bound], ep=beh['moving'])[0])\n",
    "    tc = tc[:last_ephys_bin]\n",
    "    tc[tc == 0.0] = np.nan   # pynapple zero-fill bug for bins with no eye-camera samples (see docstring)\n",
    "    return tc.reshape(n_trials, bpt)\n",
    "\n",
    "eye_x_trials = bin_continuous(beh['eye_x'], blink_mask)\n",
    "eye_y_trials = bin_continuous(beh['eye_y'], blink_mask)\n",
    "eye_dil_trials = bin_continuous(beh['eye_dilation'], blink_mask)\n",
    "print(f'eye_x_trials shape={eye_x_trials.shape}, {100*np.isnan(eye_x_trials).mean():.2f}% NaN bins overall (blinks + no-camera-sample bins both correctly excluded now)')\n",
    "print(f'trial 0 nan frac: {np.isnan(eye_x_trials).mean(axis=1)[0]:.2f} (partial first trial, expected)')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3bab61fe",
   "metadata": {},
   "source": [
    "## Trial-level gaze deviation from the session's typical gaze pattern"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "74021737",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-31T08:45:01.199232Z",
     "iopub.status.busy": "2026-08-31T08:45:01.199086Z",
     "iopub.status.idle": "2026-08-31T08:45:01.971384Z",
     "shell.execute_reply": "2026-08-31T08:45:01.970983Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Spearman corr(frac_anchored, gaze_deviation) = -0.17 (p=0.009), n=225 trials\n",
      "population-anchored trials (frac>0.5, n=122): gaze dev mean=1.1px\n",
      "population-non-anchored trials (frac<=0.5, n=103): gaze dev mean=1.2px\n",
      "Mann-Whitney U=5105, p=0.016\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x320 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\"\"\"\n",
    "Reference gaze profile = median eye position at each position bin, across\n",
    "all trials (the \"typical\" gaze pattern the animal shows navigating the\n",
    "track). Per-trial deviation = mean Euclidean distance of that trial's gaze\n",
    "profile from the reference, per matching position bin -- i.e. does the trial\n",
    "look at something different from where it usually looks, at the SAME points\n",
    "along the track (isolating idiosyncratic gaze shifts from any overall\n",
    "trial-to-trial pixel drift/calibration noise, which would shift ALL bins\n",
    "together and wash out in this comparison much less than a shift confined to\n",
    "particular track positions).\n",
    "\"\"\"\n",
    "ref_x = np.nanmedian(eye_x_trials, axis=0)\n",
    "ref_y = np.nanmedian(eye_y_trials, axis=0)\n",
    "gaze_dev = np.nanmean(np.sqrt((eye_x_trials - ref_x) ** 2 + (eye_y_trials - ref_y) ** 2), axis=1)\n",
    "\n",
    "valid = ~np.isnan(gaze_dev) & ~np.isnan(frac_anchored)\n",
    "r, p = spearmanr(frac_anchored[valid], gaze_dev[valid])\n",
    "print(f'Spearman corr(frac_anchored, gaze_deviation) = {r:.2f} (p={p:.3f}), n={valid.sum()} trials')\n",
    "\n",
    "anchored_trials = valid & (frac_anchored > 0.5)\n",
    "nonanchored_trials = valid & (frac_anchored <= 0.5)\n",
    "u, p_mw = mannwhitneyu(gaze_dev[anchored_trials], gaze_dev[nonanchored_trials], alternative='two-sided')\n",
    "print(f'population-anchored trials (frac>0.5, n={anchored_trials.sum()}): '\n",
    "      f'gaze dev mean={np.nanmean(gaze_dev[anchored_trials]):.1f}px')\n",
    "print(f'population-non-anchored trials (frac<=0.5, n={nonanchored_trials.sum()}): '\n",
    "      f'gaze dev mean={np.nanmean(gaze_dev[nonanchored_trials]):.1f}px')\n",
    "print(f'Mann-Whitney U={u:.0f}, p={p_mw:.3f}')\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(8, 3.2))\n",
    "ax = axes[0]\n",
    "ax.scatter(frac_anchored[valid], gaze_dev[valid], s=10, color=ANCH_COLOR, alpha=0.6)\n",
    "ax.set_xlabel('fraction of population anchored (trial)')\n",
    "ax.set_ylabel('gaze deviation from\\ntypical profile (px)')\n",
    "ax.set_title(f'r={r:.2f}, p={p:.3f}', fontsize=9)\n",
    "\n",
    "ax = axes[1]\n",
    "bp = ax.boxplot([gaze_dev[nonanchored_trials], gaze_dev[anchored_trials]],\n",
    "                 tick_labels=['non-anchored\\n(<=50% cells)', 'anchored\\n(>50% cells)'],\n",
    "                 patch_artist=True, widths=0.5)\n",
    "for patch, color in zip(bp['boxes'], [NONANCH_COLOR, ANCH_COLOR]):\n",
    "    patch.set_facecolor(color)\n",
    "ax.set_ylabel('gaze deviation (px)')\n",
    "ax.set_title(f'Mann-Whitney p={p_mw:.3f}', fontsize=9)\n",
    "\n",
    "fig.suptitle(f'M{MOUSE}D{DAY}: gaze deviation vs. population task-anchoring', fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.savefig(os.path.join(FIGPATH, f'eye_position_deviation_vs_anchoring_M{MOUSE}D{DAY}.pdf'), dpi=200, bbox_inches='tight')\n",
    "plt.show()\n"
   ]
  },
  {
